// Data model: see ARCHITECTURE.md §4.
// Better Auth tables (User, Session, Account, Verification) were generated with
// `pnpm dlx auth@1.7.12 generate` and keep their @@map to the Better Auth table names.
// Domain models have no @@map, so raw SQL row locks can use the model names.
// All timestamps are timestamptz. Domain models have no time defaults: core sets them from `now`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// Declaration order = value 1–9, used for range comparisons.
enum Rank {
  IRON
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
  ASCENDANT
  IMMORTAL
  RADIANT
}

enum VerifStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScrimFormat {
  ONE_MAP
  TWO_MAPS
  BO3
}

enum RequestStatus {
  OPEN
  BOOKED
  CANCELLED
  EXPIRED
  // A direct request the target team declined (Phase 30, §5.28).
  DECLINED
}

// Role of a team member (SPEC N-1); only players and substitutes count for readiness.
enum MemberRole {
  PLAYER
  SUBSTITUTE
  COACH
}

enum AppStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum ScrimStatus {
  SCHEDULED
  CANCELLED
  AWAITING_FEEDBACK
  COMPLETED
  NO_SHOW
  DISPUTED
  UNCONFIRMED
}

enum FeedbackOutcome {
  PLAYED
  OPPONENT_NO_SHOW
  WE_COULD_NOT
}

// Staff roles (ARCHITECTURE §5.9): the operator assigns admins and reviewers.
enum StaffRole {
  OPERATOR
  ADMIN
  REVIEWER
}

// See ARCHITECTURE.md §6.1.
enum NotifType {
  VERIFICATION_RESULT
  APPLICATION_RECEIVED
  APPLICATION_REJECTED
  REQUEST_DELETED
  REQUEST_EXPIRED
  SCRIM_BOOKED
  SCRIM_CANCELLED
  REMINDER_24H
  REMINDER_1H
  FEEDBACK_PROMPT
  CHANNEL_BROKEN
  // Phase 30 (§5.28): direct requests and fixed partners.
  DIRECT_REQUEST_RECEIVED
  DIRECT_REQUEST_DECLINED
  PARTNERSHIP_ENDED
}

enum NotifChannel {
  USER_DM
  // Only in entries from before Phase 18; the sender fans them out like PERSONAL (§5.17).
  CAPTAIN_DM
  TEAM_CHANNEL
  // Phase 18: a mail to targetUser.
  USER_EMAIL
  // Phase 18: a personal notification, fanned out by the sender into USER_DM and USER_EMAIL.
  PERSONAL
}

enum NotifStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

// The background a team logo is made for (Phase 11): DARK = light colours for dark backgrounds.
enum LogoBackground {
  DARK
  LIGHT
}

// The design an account chose (Phase 17, §5.16): SYSTEM follows the device setting.
enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

// The language an account chose (Phase 22, §5.21).
enum Locale {
  DE
  EN
}

// Phase 21 (§5.20): a request for more teams.
enum TeamLimitStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Better Auth ──────────────────────────────────────────────────────────────

model User {
  id            String   @id
  name          String
  // Placeholder `<discordId>@users.uniscrims.invalid`, never used for sending (§5.1).
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  // Additional fields (Better Auth `additionalFields` with `input: false`), set only by core.
  universityId     String?
  university       University?     @relation(fields: [universityId], references: [id])
  universityOther  String?
  verifiedAt       DateTime?       @db.Timestamptz(3)
  bannedAt         DateTime?       @db.Timestamptz(3)
  hubJoinFailedAt  DateTime?       @db.Timestamptz(3)
  dmFailedAt       DateTime?       @db.Timestamptz(3)
  // Set by deleteAccount and kept, also if a racing login writes the Discord profile back (§4, §5.1).
  deletedAt        DateTime?       @db.Timestamptz(3)
  // Real name from the registration (Phase 7, §5.8); null for accounts from before Phase 7 until
  // they are completed, and for deleted ones. Only the user and reviewers see it.
  firstName        String?
  lastName         String?
  // Phase 8 (§5.9): null = no role. twoFactorEnabled belongs to Better Auth's twoFactor plugin.
  staffRole        StaffRole?
  twoFactorEnabled Boolean         @default(false)
  // Phase 12 (§5.12): when the copy of the Discord avatar was made; null = none. Versions its URL.
  avatarUpdatedAt  DateTime?       @db.Timestamptz(3)
  // Phase 17 (§5.16): light or dark for this account on every device.
  theme            ThemePreference @default(SYSTEM)
  // Phase 20 (§5.19): self-declared Valorant rank, null = none; the team rank is computed from it.
  rank             Rank?
  // Phase 21 (§5.20): the team the pages show; if it is not an own team, the last joined one counts.
  activeTeamId     String?
  activeTeam       Team?           @relation("UserActiveTeam", fields: [activeTeamId], references: [id], onDelete: SetNull)
  // Phase 21 (§5.20): how many teams the user may be in; raised by an admin on request.
  teamLimit        Int             @default(5)
  // Phase 22 (§5.21): the chosen language on every device; null = never chosen.
  locale           Locale?

  avatar                  UserAvatar?
  notificationPreferences NotificationPreference[]
  sessions                Session[]
  accounts                Account[]
  twoFactors              TwoFactor[]

  verificationRequests VerificationRequest[] @relation("VerificationRequestUser")
  pendingVerification  VerificationRequest?  @relation("VerificationRequestPendingUser")
  decidedVerifications VerificationRequest[] @relation("VerificationRequestDecidedBy")
  captainOf            Team[]
  memberships          TeamMember[]
  teamLimitRequests    TeamLimitRequest[]    @relation("TeamLimitRequestUser")
  pendingTeamLimit     TeamLimitRequest?     @relation("TeamLimitRequestPendingUser")
  decidedTeamLimits    TeamLimitRequest[]    @relation("TeamLimitRequestDecidedBy")
  createdRequests      ScrimRequest[]
  createdSeries        RequestSeries[]
  submittedFeedback    ScrimFeedback[]
  resolvedScrims       Scrim[]               @relation("ScrimResolvedBy")
  notifications        Notification[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// The Discord user ID lives in `accountId` (providerId = 'discord'); there is no discordId column on User.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  // One Discord account belongs to one user, and a user has at most one per provider (§5.8):
  // the Discord ID is the ban anchor and the DM target.
  @@unique([providerId, accountId])
  @@unique([userId, providerId])
  @@index([userId])
  @@map("account")
}

// Better Auth's twoFactor plugin (Phase 8, §5.9); secret and backup codes are encrypted by Better Auth.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

// ─── Domain ───────────────────────────────────────────────────────────────────

model University {
  id   String @id @default(cuid())
  name String
  city String
  slug String @unique

  users                User[]
  verificationRequests VerificationRequest[]
}

model VerificationRequest {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation("VerificationRequestUser", fields: [userId], references: [id])
  // = userId while PENDING, otherwise null ⇒ at most one open request per user.
  pendingUserId   String?     @unique
  pendingUser     User?       @relation("VerificationRequestPendingUser", fields: [pendingUserId], references: [id])
  universityId    String?
  university      University? @relation(fields: [universityId], references: [id])
  universityOther String?
  // null once the file has been deleted.
  filePath        String?
  mimeType        String
  sizeBytes       Int
  status          VerifStatus
  rejectReason    String?
  createdAt       DateTime    @db.Timestamptz(3)
  decidedAt       DateTime?   @db.Timestamptz(3)
  // null on automatic rejection.
  decidedById     String?
  decidedBy       User?       @relation("VerificationRequestDecidedBy", fields: [decidedById], references: [id])

  @@index([userId])
  @@index([status, createdAt])
}

// Phase 21 (§5.20): a request for a higher team limit, decided by an admin.
model TeamLimitRequest {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation("TeamLimitRequestUser", fields: [userId], references: [id])
  // = userId while PENDING, otherwise null ⇒ at most one open request per user.
  pendingUserId String?         @unique
  pendingUser   User?           @relation("TeamLimitRequestPendingUser", fields: [pendingUserId], references: [id])
  // 10–500 characters.
  reason        String
  status        TeamLimitStatus
  // The new limit, set when approved.
  newLimit      Int?
  createdAt     DateTime        @db.Timestamptz(3)
  decidedAt     DateTime?       @db.Timestamptz(3)
  decidedById   String?
  decidedBy     User?           @relation("TeamLimitRequestDecidedBy", fields: [decidedById], references: [id])

  @@index([userId])
  @@index([status, createdAt])
}

// State: active (bannedAt and dissolvedAt null) | banned | dissolved. Banned and dissolved are final in the MVP.
model Team {
  id                     String    @id @default(cuid())
  name                   String
  // lowercase + trimmed ⇒ case-insensitive unique name; null after dissolution.
  nameNormalized         String?   @unique
  // 2–5 characters, not unique.
  tag                    String
  game                   String    @default("valorant")
  // Single source of truth for the captain role; intentionally not unique.
  captainId              String
  captain                User      @relation(fields: [captainId], references: [id])
  // 12 URL-safe characters; null after dissolution.
  inviteCode             String?   @unique
  discordGuildId         String?
  discordChannelId       String?
  bannedAt               DateTime? @db.Timestamptz(3)
  dissolvedAt            DateTime? @db.Timestamptz(3)
  createdAt              DateTime  @db.Timestamptz(3)
  // Last change to a logo; null = no logo. Versions both logo URLs (Phase 10, both logos since 11).
  logoUpdatedAt          DateTime? @db.Timestamptz(3)
  // External links set by the captain, https only, host checked per platform (Phase 19).
  discordUrl             String?
  websiteUrl             String?
  xUrl                   String?
  instagramUrl           String?
  twitchUrl              String?
  youtubeUrl             String?
  tiktokUrl              String?
  // Last change to the links; null = no links. The version an admin removes (Phase 19).
  linksUpdatedAt         DateTime? @db.Timestamptz(3)
  // Shown in the teams list with its members; the captain turns it off (Phase 24).
  listed                 Boolean   @default(true)
  // Only fully verified teams may apply to this team's requests; the captain turns it on (Phase 25).
  verifiedApplicantsOnly Boolean   @default(false)

  logos                TeamLogo[]
  members              TeamMember[]
  requests             ScrimRequest[]
  requestSeries        RequestSeries[]
  // Phase 30: direct requests to this team and fixed partnerships with it as the partner.
  directRequests       ScrimRequest[]  @relation("ScrimRequestTarget")
  partnerRequestSeries RequestSeries[] @relation("RequestSeriesTarget")
  applications         Application[]
  hostScrims           Scrim[]         @relation("ScrimHostTeam")
  guestScrims          Scrim[]         @relation("ScrimGuestTeam")
  cancelled            Scrim[]         @relation("ScrimCancelledByTeam")
  noShows              Scrim[]         @relation("ScrimNoShowTeam")
  feedback             ScrimFeedback[]
  notifications        Notification[]
  activeFor            User[]          @relation("UserActiveTeam")

  @@index([captainId])
}

// Copy of the Discord avatar (Phase 12, §5.12), in its own table so requireUser, which loads the
// whole user row, never loads image bytes. A row exists exactly when User.avatarUpdatedAt is set.
model UserAvatar {
  userId String @id
  user   User   @relation(fields: [userId], references: [id])
  // 128×128 WebP made by the server.
  data   Bytes
}

// Own table so the many reads of whole Team rows never load image bytes (Phase 10, §5.11).
// Up to one row per background (Phase 11); there is a row exactly when Team.logoUpdatedAt is set.
model TeamLogo {
  teamId     String
  team       Team           @relation(fields: [teamId], references: [id])
  // Logos from Phase 10, when the site was dark only, become logos for dark backgrounds.
  background LogoBackground @default(DARK)
  // 256×256 lossless WebP made by the server.
  data       Bytes

  @@id([teamId, background])
}

// The captain is always a member too; max. 10 members (both enforced in core).
model TeamMember {
  teamId   String
  team     Team       @relation(fields: [teamId], references: [id])
  // Up to User.teamLimit teams per user since Phase 21 (counted in core); unique until then.
  userId   String
  user     User       @relation(fields: [userId], references: [id])
  // Set by the captain; independent of the captain role (Team.captainId).
  role     MemberRole @default(PLAYER)
  joinedAt DateTime   @db.Timestamptz(3)

  @@id([teamId, userId])
  @@index([userId])
}

model ScrimRequest {
  id                 String         @id @default(cuid())
  teamId             String
  team               Team           @relation(fields: [teamId], references: [id])
  createdById        String
  createdBy          User           @relation(fields: [createdById], references: [id])
  game               String         @default("valorant")
  startsAt           DateTime       @db.Timestamptz(3)
  format             ScrimFormat
  rankMin            Rank
  rankMax            Rank
  maps               String[]
  note               String?
  status             RequestStatus
  createdAt          DateTime       @db.Timestamptz(3)
  // Posted for a weekly series (Phase 29, §5.27); null = a single request.
  seriesId           String?
  series             RequestSeries? @relation(fields: [seriesId], references: [id])
  // A direct request to this team, not on the board (Phase 30, §5.28); null = a board request.
  targetTeamId       String?
  targetTeam         Team?          @relation("ScrimRequestTarget", fields: [targetTeamId], references: [id])
  // A direct request proposing a fixed partnership up to this last date (Phase 30, §5.28).
  weeklyLastStartsAt DateTime?      @db.Timestamptz(3)

  applications  Application[]
  scrim         Scrim?
  notifications Notification[]

  @@unique([seriesId, startsAt])
  @@index([status, startsAt])
  @@index([teamId])
  @@index([targetTeamId])
}

// A weekly recurring request (Phase 29, §5.27). The sweeper posts each date a week before its start,
// when the previous date starts, with these fields; createdById is also the author of their note.
model RequestSeries {
  id           String      @id @default(cuid())
  teamId       String
  team         Team        @relation(fields: [teamId], references: [id])
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  game         String      @default("valorant")
  format       ScrimFormat
  rankMin      Rank
  rankMax      Rank
  maps         String[]
  note         String?
  // The next date not yet posted or skipped.
  nextStartsAt DateTime    @db.Timestamptz(3)
  // The last date, on or before the end date.
  lastStartsAt DateTime    @db.Timestamptz(3)
  // Ended by the captain, after the last date, by a ban or a dissolution; null = running.
  endedAt      DateTime?   @db.Timestamptz(3)
  // A fixed partnership with this team, accepted when it was created; books instead of posting
  // (Phase 30, §5.28).
  targetTeamId String?
  targetTeam   Team?       @relation("RequestSeriesTarget", fields: [targetTeamId], references: [id])
  createdAt    DateTime    @db.Timestamptz(3)

  requests ScrimRequest[]

  @@index([endedAt, nextStartsAt])
  @@index([teamId])
  @@index([targetTeamId])
}

model Application {
  id        String       @id @default(cuid())
  requestId String
  request   ScrimRequest @relation(fields: [requestId], references: [id])
  teamId    String
  team      Team         @relation(fields: [teamId], references: [id])
  message   String?
  status    AppStatus
  createdAt DateTime     @db.Timestamptz(3)
  decidedAt DateTime?    @db.Timestamptz(3)

  // No second application, not even after WITHDRAWN.
  @@unique([requestId, teamId])
  @@index([teamId])
}

model Scrim {
  id                String       @id @default(cuid())
  requestId         String       @unique
  request           ScrimRequest @relation(fields: [requestId], references: [id])
  hostTeamId        String
  hostTeam          Team         @relation("ScrimHostTeam", fields: [hostTeamId], references: [id])
  guestTeamId       String
  guestTeam         Team         @relation("ScrimGuestTeam", fields: [guestTeamId], references: [id])
  startsAt          DateTime     @db.Timestamptz(3)
  format            ScrimFormat
  maps              String[]
  // = startsAt + FEEDBACK_OFFSET
  feedbackOpensAt   DateTime     @db.Timestamptz(3)
  // = feedbackOpensAt + FEEDBACK_WINDOW
  feedbackDeadline  DateTime     @db.Timestamptz(3)
  status            ScrimStatus
  // On ban/dissolution: cancelledByTeamId = affected team, lateCancel = false.
  cancelledByTeamId String?
  cancelledByTeam   Team?        @relation("ScrimCancelledByTeam", fields: [cancelledByTeamId], references: [id])
  cancelledAt       DateTime?    @db.Timestamptz(3)
  lateCancel        Boolean      @default(false)
  noShowTeamId      String?
  noShowTeam        Team?        @relation("ScrimNoShowTeam", fields: [noShowTeamId], references: [id])
  // Admin decision on a dispute.
  resolvedById      String?
  resolvedBy        User?        @relation("ScrimResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt        DateTime?    @db.Timestamptz(3)
  createdAt         DateTime     @db.Timestamptz(3)

  feedback      ScrimFeedback[]
  notifications Notification[]

  @@index([status, startsAt])
  @@index([status, feedbackDeadline])
  @@index([hostTeamId])
  @@index([guestTeamId])
}

model ScrimFeedback {
  id            String          @id @default(cuid())
  scrimId       String
  scrim         Scrim           @relation(fields: [scrimId], references: [id])
  // The responding team.
  teamId        String
  team          Team            @relation(fields: [teamId], references: [id])
  submittedById String
  submittedBy   User            @relation(fields: [submittedById], references: [id])
  outcome       FeedbackOutcome
  // 1–5, about the opponent; only for PLAYED.
  rating        Int?
  createdAt     DateTime        @db.Timestamptz(3)

  @@unique([scrimId, teamId])
}

// Outbox, see ARCHITECTURE.md §6.
model Notification {
  id           String        @id @default(cuid())
  type         NotifType
  channel      NotifChannel
  // USER_DM, USER_EMAIL and PERSONAL to a person.
  targetUserId String?
  targetUser   User?         @relation(fields: [targetUserId], references: [id])
  // CAPTAIN_DM, TEAM_CHANNEL and PERSONAL to a team; fanned-out children have both (§5.17).
  targetTeamId String?
  targetTeam   Team?         @relation(fields: [targetTeamId], references: [id])
  scrimId      String?
  scrim        Scrim?        @relation(fields: [scrimId], references: [id])
  requestId    String?
  request      ScrimRequest? @relation(fields: [requestId], references: [id])
  // Display data only.
  payload      Json
  // Set from the `now` parameter when created; no database default.
  scheduledFor DateTime      @db.Timestamptz(3)
  status       NotifStatus
  attempts     Int           @default(0)
  lastError    String?
  // <type>:<triggering entity per §6.1>:<userId|teamId>:<channel>; children: entity = parent id
  dedupeKey    String        @unique
  createdAt    DateTime      @db.Timestamptz(3)
  sentAt       DateTime?     @db.Timestamptz(3)

  @@index([status, scheduledFor])
  @@index([scrimId])
  @@index([requestId])
  @@index([targetUserId])
}

// Phase 18 (§5.17): a person's choice per notification type; null = the default (mail off,
// Discord on, for scrim types only for the team's captain). No row = defaults only.
model NotificationPreference {
  userId  String
  user    User      @relation(fields: [userId], references: [id])
  type    NotifType
  discord Boolean?
  email   Boolean?

  @@id([userId, type])
}

model SystemStatus {
  // One row per bot loop: 'bot' (sweeper) and 'outbox' (sender), ARCHITECTURE §6.3
  id          String   @id
  heartbeatAt DateTime @db.Timestamptz(3)
}
