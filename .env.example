# Local dev databases from docker/docker-compose.dev.yml
DATABASE_URL=postgresql://uniscrims:uniscrims@localhost:5433/uniscrims
DATABASE_URL_TEST=postgresql://uniscrims:uniscrims@localhost:5434/uniscrims_test
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://deine-domain.de
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
HUB_GUILD_ID=
HUB_INVITE_URL=
ADMIN_DISCORD_IDS=123,456
# Absolute path; locally e.g. /Users/<you>/uni-scrims-uploads
UPLOAD_DIR=/data/uploads
# For links in bot messages
PUBLIC_BASE_URL=https://deine-domain.de
# Absolute path to impressum.txt and datenschutz.txt; locally e.g. /Users/<you>/uni-scrims/docker/legal.example.
# In production docker/docker-compose.yml sets /config/legal itself.
LEGAL_DIR=
# Production only (docker/docker-compose.yml): domain for Caddy and the database password (hex, URL-safe)
DOMAIN=deine-domain.de
POSTGRES_PASSWORD=
DEV_LOGIN=false
DEV_DM_REDIRECT_DISCORD_ID=
DEV_CHANNEL_ID=
DEV_TIME_OFFSETS=false
# Account mails (Phase 7, ARCHITECTURE §5.8)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Uni Scrims <noreply@uniscrims.com>"
# Development only: all mails go to this address; empty = only into the log
DEV_MAIL_REDIRECT=
